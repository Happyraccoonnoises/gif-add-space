DirectoryIndex index.html
Options -MultiViews

RewriteEngine On

# Unter / intern die Secret-Rave-Seite anzeigen.
RewriteRule ^$ geheim.php [END]

# Statische Assets weiterhin ausliefern.
RewriteRule \.(?:css|js|mjs|png|jpe?g|gif|svg|webp|avif|ico|bmp|apng|woff2?|ttf|otf|eot|mp4|webm|og[gv]|mp3|wav|m4a|aac|flac|json|webmanifest|wasm)$ - [NC,END]

# Alle anderen URLs auf / umleiten.
RewriteRule ^ / [R=302,L]

# Fehlende Assets als 404-Fehler behandeln.
ErrorDocument 404 default
